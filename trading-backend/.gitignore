# Build outputs
target/
*.class
*.jar
*.war

# IDE files
.idea/
*.iml
.vscode/
*.swp
*.swo

# Secrets - NEVER COMMIT
# config.properties itself is now tracked (2026-09-03): it holds no credentials —
# ALPACA_API_KEY/SECRET moved to Fly.io secrets long ago — only trading-strategy
# config + tuning-history comments, which is exactly what shouldn't live untracked
# and unbackable-up on a single local machine. If real credentials are ever added
# back to this file, re-add it here immediately.
*.secret
.env
.env.local
.env.*.local

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db

# Node modules (dashboard)
node_modules/
dashboard/node_modules/
dashboard/dist/

# Temporary files
*.tmp
*.bak
*.orig

# Docker local overrides
docker-compose.override.yml
